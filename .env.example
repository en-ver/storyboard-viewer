# Optional Compose interpolation values. Copy this file to .env and uncomment
# only the values you need. These values do not configure the MCP client.
# Exported shell variables take precedence over .env.

# Compose project identity. Overrides the top-level name in docker-compose.yml.
# The command-line --project-name option takes precedence over this variable.
# COMPOSE_PROJECT_NAME=storyboard-viewer

# Local image tag. Build the image before the first deployment.
# STORYBOARD_IMAGE=storyboard-viewer:local

# Container name. Use this same name in the MCP client's docker exec arguments.
# STORYBOARD_CONTAINER_NAME=storyboard-viewer

# Host port, published only on 127.0.0.1. The container port stays 4400.
# STORYBOARD_PORT=4400

# Existing host directory containing storyboards. Default: ./storyboard.
# Relative paths resolve from the Compose project directory.
# Create or select this directory before starting the container.
# For an absolute path, use your own directory, with forward slashes on Windows.
# STORYBOARD_DIR=./storyboard

# Persistent named volume for native CLI configuration, not storyboard files.
# STORYBOARD_CONFIG_VOLUME=storyboard-viewer_config

# For separate installations, choose distinct project names, container names,
# ports, and configuration volumes. A project-name change alone is not enough.
