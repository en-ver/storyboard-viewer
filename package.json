{
  "name": "storyboard-viewer",
  "private": true,
  "version": "0.5.3",
  "description": "Storyboard Viewer: an offline-first storyboard app (.sbd) that AI agents edit through MCP while you watch.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://storyboard-viewer.saimun-shahee.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swaymun/storyboard-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/swaymun/storyboard-viewer/issues"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @storyboard-viewer/web dev",
    "test": "node --test scripts/test/*.test.mjs && pnpm -r test",
    "test:image": "SBD_DOCKER_TESTS=1 node --test scripts/test/image-build.test.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "oxlint && prettier --check . && pnpm typecheck",
    "format": "prettier --write .",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "example": "node scripts/make-example.mjs",
    "test:e2e": "playwright test",
    "sbd": "node packages/cli/dist/cli.js",
    "screenshots": "node scripts/screenshots.mjs",
    "fixture:storyboarder": "node scripts/make-storyboarder-fixture.mjs",
    "examples:web": "node scripts/pack-web-examples.mjs",
    "deploy:web": "pnpm --filter @storyboard-viewer/web build && npx -y wrangler@4 deploy",
    "deploy:web:dry": "pnpm --filter @storyboard-viewer/web build && npx -y wrangler@4 deploy --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
