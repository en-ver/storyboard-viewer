# Allow only build inputs. This also excludes linked-worktree .git pointer files,
# credentials, local Compose files, examples, reports and unrelated host files.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!LICENSE
!packages/
!packages/cli/
!packages/cli/package.json
!packages/cli/tsconfig*.json
!packages/cli/src/
!packages/cli/src/**
!packages/cli/scripts/
!packages/cli/scripts/copy-web.mjs
!packages/format/
!packages/format/package.json
!packages/format/tsconfig*.json
!packages/format/src/
!packages/format/src/**
!apps/
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/svelte.config.js
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!scripts/
!scripts/check-image-package.mjs

# Never consume host installation or build output, even under allowed paths.
**/.git
**/node_modules
**/dist
**/dev-dist
packages/cli/web
**/coverage
**/.vite
**/.wrangler
**/*.tsbuildinfo
**/*.log
**/.env
**/.env.*
**/.npmrc
**/.pnpmfile.cjs
**/.DS_Store
**/test-results
**/playwright-report
